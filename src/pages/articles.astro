---
import Base from '../layouts/Base.astro';
import { getArticles, url, fmt } from '../articles.js';

const byYear = Object.groupBy(await getArticles(), (a) => a.data.date.getFullYear());
const years = Object.keys(byYear).sort((a, b) => b - a);
---
<Base title="Articles">
  <h1>Articles</h1>
  {years.map((y) => (
    <>
      <h2 class="meta">{y}</h2>
      <ul class="plain">
        {byYear[y].map((a) => (
          <li><a href={url(a)}>{a.data.title}</a> <time class="meta">{fmt(a.data.date)}</time></li>
        ))}
      </ul>
    </>
  ))}
</Base>
